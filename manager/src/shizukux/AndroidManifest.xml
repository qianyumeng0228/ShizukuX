<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ShizukuX flavor (applicationId xyz.shizuku.extra.api) CAN be installed alongside stock Shizuku,
         which owns moe.shizuku.manager.permission.API_V23. If the ShizukuX manager also defined it,
         installing both would fail with -126 INSTALL_FAILED_DUPLICATE_PERMISSION (#316). So ShizukuX
         must NOT define it — the separate Compat Hub (package moe.shizuku.privileged.api, mutually
         exclusive with stock) is the definer for the ShizukuX flavor. This remove strips any definition
         that could merge in from a dependency. The dropin flavor defines it instead (see
         src/dropin/AndroidManifest.xml). -->
    <permission
        android:name="moe.shizuku.manager.permission.API_V23"
        tools:node="remove" />

    <!-- Only this flavor owns xyz.shizuku.extra.api, so the DEFINITIONS of the Extra permissions
         belong here. They used to sit in the shared main manifest, which made the dropin build
         redeclare them too — and that collides with the installed xyz.shizuku.extra.api package
         (INSTALL_FAILED_DUPLICATE_PERMISSION). -->
    <permission
        android:name="xyz.shizuku.extra.permission.MANAGER"
        android:protectionLevel="signature" />

    <permission
        android:name="xyz.shizuku.extra.permission.API_V23"
        android:description="@string/permission_description"
        android:icon="@drawable/ic_system_icon"
        android:label="@string/permission_label"
        android:permissionGroup="${applicationId}.permission-group.API"
        android:protectionLevel="dangerous" />

</manifest>
