<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeOverlay"/>
    <style name="ThemeOverlay.Accent" parent=""/>

    <style name="ThemeOverlay.Black">
        <item name="android:colorPrimary">@android:color/black</item>
        <item name="android:colorPrimaryDark">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceContainerLow">?colorSurfaceContainerLowest</item>
        <!-- Cards/settings groups use colorSurfaceContainerHigh (see home_item_container.xml,
             M3ECardItemDecoration) - dial it down one tone step so AMOLED cards stay close to
             true black instead of inheriting the base theme's full-contrast High tone. -->
        <item name="colorSurfaceContainerHigh">?colorSurfaceContainer</item>
        <!-- shape_edit_control_background.xml (home-card edit-mode drag/remove chip) uses
             Highest - same one-step-down treatment. This resolves through the High remap above
             (Android's ?attr resolution is against the fully merged theme, not each item's
             pre-overlay value), so Highest ties with High/Container here, same as Low already
             ties with Lowest above. That's fine for this chip specifically: both icons inside it
             (ic_drag_handle, ic_close_24) are tinted independently via colorControlNormal/
             colorError, not derived from this background, so they stay visible even if the
             chip's own background blends into the card behind it. -->
        <item name="colorSurfaceContainerHighest">?colorSurfaceContainerHigh</item>
    </style>

    <style name="ThemeOverlay.DynamicColors.Light" parent="ThemeOverlay.Material3.DynamicColors.Light.Shizuku"/>

    <style name="ThemeOverlay.DynamicColors.Dark" parent="ThemeOverlay.Material3.DynamicColors.Dark.Shizuku"/>

    <!-- Violet Accent Overlay -->
    <style name="ThemeOverlay.Accent.Violet">
        <item name="colorPrimary">#7B1FA2</item>
        <item name="colorPrimaryContainer">#F3E5F5</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#4A148C</item>
    </style>
    <style name="ThemeOverlay.Accent.Violet.Dark">
        <item name="colorPrimary">#E040FB</item>
        <item name="colorPrimaryContainer">#4A148C</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnPrimaryContainer">#F3E5F5</item>
    </style>

    <!-- Green Accent Overlay -->
