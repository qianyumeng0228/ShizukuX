        <item name="colorPrimaryContainer">#004D40</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnPrimaryContainer">#E0F2F1</item>
    </style>

    <!-- Crimson Accent Overlay -->
    <style name="ThemeOverlay.Accent.Crimson">
        <item name="colorPrimary">#C2185B</item>
        <item name="colorPrimaryContainer">#FCE4EC</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#880E4F</item>
    </style>
    <style name="ThemeOverlay.Accent.Crimson.Dark">
        <item name="colorPrimary">#FF4081</item>
        <item name="colorPrimaryContainer">#880E4F</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnPrimaryContainer">#FCE4EC</item>
    </style>

    <!-- Ocean Accent Overlay -->
    <style name="ThemeOverlay.Accent.Ocean">
        <item name="colorPrimary">#0288D1</item>
        <item name="colorPrimaryContainer">#E1F5FE</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#01579B</item>
    </style>
    <style name="ThemeOverlay.Accent.Ocean.Dark">
        <item name="colorPrimary">#40C4FF</item>
        <item name="colorPrimaryContainer">#01579B</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnPrimaryContainer">#E1F5FE</item>
    </style>

    <!--
        Shape Style overlays (settings key "shape_style", gated on "expressive_shapes").
        "zen" (the default) applies neither - it keeps whatever corner scale the base
        Theme.Material3Expressive.* theme already provides, preserving today's look.
        Standard Material 3 corner-radius scale reference: xs=4dp, s=8dp, m=12dp, l=16dp, xl=28dp.
    -->
    <style name="ShapeAppearance.Modern.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="ShapeAppearance.Modern.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.Modern.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Modern.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.Modern.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ThemeOverlay.Shape" parent=""/>

    <style name="ThemeOverlay.Shape.Modern">
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Modern.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Modern.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Modern.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Modern.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Modern.Corner.ExtraLarge</item>
    </style>

    <!-- Classic (Material 2): flatter, boxier corners, no "Full"/pill shapes. -->
    <style name="ShapeAppearance.Classic.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>
    <style name="ShapeAppearance.Classic.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="ShapeAppearance.Classic.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="ShapeAppearance.Classic.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.Classic.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ThemeOverlay.Shape.Classic">
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Classic.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Classic.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Classic.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Classic.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Classic.Corner.ExtraLarge</item>
    </style>

    <!-- Organic (Squircle): generously rounded, continuous-looking corners throughout. -->
    <style name="ShapeAppearance.Squircle.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Squircle.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.Squircle.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.Squircle.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ShapeAppearance.Squircle.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">36dp</item>
    </style>
    <style name="ThemeOverlay.Shape.Squircle">
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Squircle.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Squircle.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Squircle.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Squircle.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Squircle.Corner.ExtraLarge</item>
    </style>

    <!--
        Expressive Shapes toggle (settings key "expressive_shapes"), when turned OFF: flattens
        the app back to plain Material3 (non-Expressive) corner treatment regardless of shape_style,
        since shape_style's own preference entry is disabled/irrelevant while this is off.
    -->
    <style name="ThemeOverlay.Shapes.Standard" parent="ThemeOverlay.Shape.Modern"/>

    <!--
        One UI style theme overlay (settings key "oneui_theme_enabled").
        Applies Samsung One UI design language: Galaxy Blue accent (#0381FE), extra-large rounded
        corners, and heavier typography. Applied after the dynamic-color and shape overlays, so
        Samsung Blue wins over Monet when this is on. Users who prefer their wallpaper color
        should leave One UI mode off.
    -->
    <style name="ShapeAppearance.OneUI.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>
    <style name="ShapeAppearance.OneUI.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.OneUI.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.OneUI.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>
    <style name="ShapeAppearance.OneUI.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">36dp</item>
    </style>

    <style name="ThemeOverlay.OneUI" parent="">
        <!-- Samsung Galaxy Blue -->
        <item name="colorPrimary">#0381FE</item>
        <item name="colorPrimaryContainer">#D5EAFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#001E3A</item>
        <item name="colorSecondary">#4A90D9</item>
        <item name="colorSecondaryContainer">#D9ECFF</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorOnSecondaryContainer">#001E3A</item>
        <!-- One UI signature extra-large corners -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.OneUI.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.OneUI.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.OneUI.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.OneUI.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.OneUI.Corner.ExtraLarge</item>
        <!-- Bolder headline typography (One UI "SamsungOne" look) -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.OneUI.HeadlineLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.OneUI.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.OneUI.TitleMedium</item>
        <!-- Preference screens: bold blue category headers + One UI item padding.
             The rikka library already sets listPreferredItemPadding* to 24dp/16dp and
             category title color to ?colorPrimary (Samsung Blue), so those are free. -->
        <item name="preferenceTheme">@style/AppTheme.PreferenceThemeOverlay.OneUI</item>
        <!-- Explicit padding assertion (rikka's ThemeOverlay.Rikka.Material3.Preference
             sets these but isn't guaranteed to be applied when we apply at overlay level) -->
        <item name="android:listPreferredItemPaddingStart">24dp</item>
        <item name="android:listPreferredItemPaddingEnd">16dp</item>
    </style>

    <style name="ThemeOverlay.OneUI.Dark" parent="ThemeOverlay.OneUI">
        <!-- Slightly lighter blue for dark-mode contrast (WCAG AA on dark surfaces) -->
        <item name="colorPrimary">#3A8BFF</item>
        <item name="colorPrimaryContainer">#003B79</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#D5EAFF</item>
        <item name="colorSecondary">#7AB4F5</item>
        <item name="colorSecondaryContainer">#003366</item>
        <item name="colorOnSecondary">#001E3A</item>
        <item name="colorOnSecondaryContainer">#D9ECFF</item>
    </style>

    <style name="TextAppearance.OneUI.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">38sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.OneUI.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.OneUI.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
