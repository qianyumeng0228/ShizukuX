<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeOverlay"/>
    <style name="ThemeOverlay.Accent" parent=""/>

    <style name="ThemeOverlay.Black">
        <item name="android:colorPrimary">@android:color/black</item>
        <item name="android:colorPrimaryDark">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <!-- AMOLED pure black: all surface-container tones forced to #000000.
             Previous ?attr forwarding (Low→Lowest, High→Container, Highest→High) left
             cards visibly grey on OLEDs because the base theme's container tokens are
             near-black (#0D0D0D etc.), not true black. #496. -->
        <item name="colorSurfaceBright">@android:color/black</item>
        <item name="colorSurfaceDim">@android:color/black</item>
        <item name="colorSurfaceContainerLowest">@android:color/black</item>
        <item name="colorSurfaceContainerLow">@android:color/black</item>
        <item name="colorSurfaceContainer">@android:color/black</item>
        <item name="colorSurfaceContainerHigh">@android:color/black</item>
        <item name="colorSurfaceContainerHighest">@android:color/black</item>
    </style>

    <style name="ThemeOverlay.DynamicColors.Light" parent="ThemeOverlay.Material3.DynamicColors.Light.Shizuku"/>

    <style name="ThemeOverlay.DynamicColors.Dark" parent="ThemeOverlay.Material3.DynamicColors.Dark.Shizuku"/>

    <!-- Violet Accent Overlay -->
    <style name="ThemeOverlay.Accent.Violet">
        <item name="colorPrimary">#7B1FA2</item>
        <item name="colorPrimaryContainer">#F3E5F5</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#4A148C</item>
    </style>
    <style name="ThemeOverlay.Accent.Violet.Dark">
        <item name="colorPrimary">#E040FB</item>
        <item name="colorPrimaryContainer">#4A148C</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnPrimaryContainer">#F3E5F5</item>
    </style>

    <!-- Green Accent Overlay -->
    <style name="ThemeOverlay.Accent.Green">
        <item name="colorPrimary">#00796B</item>
        <item name="colorPrimaryContainer">#E0F2F1</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#004D40</item>
    </style>
    <style name="ThemeOverlay.Accent.Green.Dark">
        <item name="colorPrimary">#64FFDA</item>
        <item name="colorPrimaryContainer">#004D40</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnPrimaryContainer">#E0F2F1</item>
    </style>

    <!-- Crimson Accent Overlay -->
    <style name="ThemeOverlay.Accent.Crimson">
        <item name="colorPrimary">#C2185B</item>
        <item name="colorPrimaryContainer">#FCE4EC</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#880E4F</item>
    </style>
    <style name="ThemeOverlay.Accent.Crimson.Dark">
        <item name="colorPrimary">#FF4081</item>
        <item name="colorPrimaryContainer">#880E4F</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnPrimaryContainer">#FCE4EC</item>
    </style>

    <!-- Ocean Accent Overlay -->
    <style name="ThemeOverlay.Accent.Ocean">
        <item name="colorPrimary">#0288D1</item>
        <item name="colorPrimaryContainer">#E1F5FE</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnPrimaryContainer">#01579B</item>
    </style>
    <style name="ThemeOverlay.Accent.Ocean.Dark">
        <item name="colorPrimary">#40C4FF</item>
        <item name="colorPrimaryContainer">#01579B</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorOnPrimaryContainer">#E1F5FE</item>
    </style>

    <!--
        Shape Style overlays (settings key "shape_style", gated on "expressive_shapes").
        "zen" (the default) applies neither - it keeps whatever corner scale the base
        Theme.Material3Expressive.* theme already provides, preserving today's look.
        Standard Material 3 corner-radius scale reference: xs=4dp, s=8dp, m=12dp, l=16dp, xl=28dp.
    -->
    <style name="ShapeAppearance.Modern.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="ShapeAppearance.Modern.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.Modern.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Modern.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.Modern.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ThemeOverlay.Shape" parent=""/>

    <style name="ThemeOverlay.Shape.Modern">
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Modern.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Modern.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Modern.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Modern.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Modern.Corner.ExtraLarge</item>
    </style>

    <!-- Classic (Material 2): flatter, boxier corners, no "Full"/pill shapes. -->
    <style name="ShapeAppearance.Classic.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>
    <style name="ShapeAppearance.Classic.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="ShapeAppearance.Classic.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="ShapeAppearance.Classic.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.Classic.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ThemeOverlay.Shape.Classic">
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Classic.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Classic.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Classic.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Classic.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Classic.Corner.ExtraLarge</item>
    </style>

    <!-- Organic (Squircle): generously rounded, continuous-looking corners throughout. -->
    <style name="ShapeAppearance.Squircle.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Squircle.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.Squircle.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.Squircle.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ShapeAppearance.Squircle.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">36dp</item>
    </style>
    <style name="ThemeOverlay.Shape.Squircle">
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Squircle.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Squircle.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Squircle.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Squircle.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Squircle.Corner.ExtraLarge</item>
    </style>

    <!-- Cut (Angular): M3 Expressive's "Embrace Tension" principle (mixing sharp/angular forms
         with soft/rounded ones) via the CUT corner family (a stable, non-experimental
         ShapeAppearance attribute) instead of ROUNDED - a genuinely different silhouette from the
         other three styles, not just a different radius on the same rounded-rect shape. Google's
         actual M3 Expressive polygon shape library (MaterialShapes - cookie/sunny/clover/pill,
         see androidx.compose.material3.MaterialShapes) can't be adopted here: it's a Compose-only
         Canvas/RoundedPolygon renderer with no equivalent in the ShapeAppearanceModel/
         MaterialCardView system this app's (mostly XML View-based) UI uses, and it's still
         @ExperimentalMaterial3ExpressiveApi (material3 1.5.0-alpha) besides. -->
    <style name="ShapeAppearance.Cut.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="ShapeAppearance.Cut.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.Cut.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Cut.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.Cut.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ThemeOverlay.Shape.Cut">
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Cut.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Cut.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Cut.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Cut.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Cut.Corner.ExtraLarge</item>
    </style>

    <!--
        Expressive Shapes toggle (settings key "expressive_shapes"), when turned OFF: flattens
        the app back to plain Material3 (non-Expressive) corner treatment regardless of shape_style,
        since shape_style's own preference entry is disabled/irrelevant while this is off.
    -->
    <style name="ThemeOverlay.Shapes.Standard" parent="ThemeOverlay.Shape.Modern"/>

    <!--
        One UI style theme overlay (settings key "oneui_theme_enabled").
        Deliberately structure-only, not color: extra-large rounded corners, heavier typography,
        and One UI-style preference padding - the app's existing dynamic-color/custom-accent
        toggle already covers color (and on One UI 4.1+ that toggle already tracks the device's
        real Monet/wallpaper color, since Samsung's dynamic theming is built on the same
        system_accent1/2/3 tokens). A separate fixed "Galaxy Blue" override here would fight that
        instead of composing with it, so this overlay sets no color attrs at all.
    -->
    <style name="ShapeAppearance.OneUI.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>
    <style name="ShapeAppearance.OneUI.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.OneUI.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.OneUI.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>
    <style name="ShapeAppearance.OneUI.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">36dp</item>
    </style>

    <style name="ThemeOverlay.OneUI" parent="">
        <!-- One UI signature extra-large corners -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.OneUI.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.OneUI.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.OneUI.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.OneUI.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.OneUI.Corner.ExtraLarge</item>
        <!-- Bolder headline typography (One UI "SamsungOne" look) -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.OneUI.HeadlineLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.OneUI.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.OneUI.TitleMedium</item>
        <!-- Preference screens: bold category headers + One UI item padding. The rikka library
             already sets listPreferredItemPadding* to 24dp/16dp and category title color to
             ?colorPrimary (whatever that resolves to - dynamic/accent/default), so those are
             free; only the text style (size/weight/spacing) is set here. -->
        <item name="preferenceTheme">@style/AppTheme.PreferenceThemeOverlay.OneUI</item>
        <!-- Explicit padding assertion (rikka's ThemeOverlay.Rikka.Material3.Preference
             sets these but isn't guaranteed to be applied when we apply at overlay level) -->
        <item name="android:listPreferredItemPaddingStart">24dp</item>
        <item name="android:listPreferredItemPaddingEnd">16dp</item>
    </style>

    <style name="TextAppearance.OneUI.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">38sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.OneUI.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.OneUI.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
        Bold Typography overlay (settings key "bold_typography").
        Applies heavier font weights for headings/titles independently of the full One UI overlay,
        so users can have bold typography without the One UI shape + preferenceTheme changes.
        Applied before ThemeOverlay.OneUI so One UI's values win when both are on.
    -->
    <style name="ThemeOverlay.Typography.Bold" parent="">
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.OneUI.HeadlineLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.OneUI.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.OneUI.TitleMedium</item>
    </style>

    <!--
        Corner Rounding overrides (settings key "corner_rounding_override").
        Each overlay only patches shapeAppearanceCornerExtraLarge — cards, bottom sheets, and
        dialogs use the chosen size while smaller corner tokens stay proportional to the active
        shape_style. "default" (already applied by the active shape overlay) needs no extra overlay.
        "system" = no overlay, base M3/M3Expressive tokens used.
    -->
    <style name="ShapeAppearance.CornerRounding.Gentle.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ThemeOverlay.CornerRounding.Gentle" parent="">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.CornerRounding.Gentle.ExtraLarge</item>
    </style>

    <style name="ShapeAppearance.CornerRounding.Standard.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ThemeOverlay.CornerRounding.Standard" parent="">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.CornerRounding.Standard.ExtraLarge</item>
    </style>

    <style name="ShapeAppearance.CornerRounding.Large.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">36dp</item>
    </style>
    <style name="ThemeOverlay.CornerRounding.Large" parent="">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.CornerRounding.Large.ExtraLarge</item>
    </style>

    <style name="ShapeAppearance.CornerRounding.Maximum.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">44dp</item>
    </style>
    <style name="ThemeOverlay.CornerRounding.Maximum" parent="">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.CornerRounding.Maximum.ExtraLarge</item>
    </style>

    <!--
        Second UI skin ("ui_style" = "glass", see ShizukuSettings.getUiStyle()).
        Structure + accent only: cards/rows get the liquid-glass treatment from
        glassCardSurfaceColor()/M3ECardItemDecoration, and the page背景 comes from
        WallpaperBackground, so this overlay stays a pure token layer that composes with
        whichever dynamic-color / custom-accent choice the user already made by overriding
        just the accent (violet #B9A7FF on dark, #6C55C9 on light) and the large corner scale
        (28dp cards / 20dp rows per the design spec).
        Dark variant is the base name so `R.style.ThemeOverlay_Glass` resolves to night.
    -->
    <style name="ShapeAppearance.Glass.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
    <style name="ShapeAppearance.Glass.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.Glass.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.Glass.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="ShapeAppearance.Glass.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ThemeOverlay.Glass" parent="">
        <item name="isGlassUi">true</item>
        <!-- Accent: #B9A7FF on the dark glass background, deep violet text on top of it. -->
        <item name="colorPrimary">#B9A7FF</item>
        <item name="colorOnPrimary">#201639</item>
        <item name="colorPrimaryContainer">#3A2C70</item>
        <item name="colorOnPrimaryContainer">#E7DEFF</item>
        <item name="colorSecondary">#B9A7FF</item>
        <item name="colorOnSecondary">#201639</item>
        <item name="colorSecondaryContainer">#33265F</item>
        <item name="colorOnSecondaryContainer">#E7DEFF</item>
        <item name="colorTertiary">#D9CFFF</item>
        <item name="colorOutline">#8E86A8</item>
        <item name="colorOutlineVariant">#4A4560</item>
        <!-- Card tone behind the translucent glass fill; slightly cooler than the M3 default. -->
        <item name="colorSurface">#141A2B</item>
        <item name="colorSurfaceBright">#1E2740</item>
        <item name="colorSurfaceDim">#0C111C</item>
        <item name="colorSurfaceContainerLowest">#0A0E17</item>
        <item name="colorSurfaceContainerLow">#121828</item>
        <item name="colorSurfaceContainer">#161D2F</item>
        <item name="colorSurfaceContainerHigh">#1B2336</item>
        <item name="colorSurfaceContainerHighest">#202A40</item>
        <!-- Content tokens must be spelled out: without them the light glass overlay inherits the
             base dark theme's white onSurface/onSurfaceVariant and card icons vanish on the now
             white cards. -->
        <item name="android:colorBackground">#0B0F19</item>
        <item name="colorOnBackground">#F2F5FA</item>
        <item name="colorOnSurface">#F2F5FA</item>
        <item name="colorOnSurfaceVariant">#A9B4C6</item>
        <item name="colorSurfaceVariant">#1A2136</item>
        <item name="colorSurfaceInverse">#EDF0FA</item>
        <item name="colorOnSurfaceInverse">#141A2B</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Glass.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Glass.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Glass.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Glass.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Glass.Corner.ExtraLarge</item>
        <item name="preferenceTheme">@style/AppTheme.PreferenceThemeOverlay.Glass</item>
    </style>

    <style name="ThemeOverlay.Glass.Light" parent="">
        <item name="isGlassUi">true</item>
        <item name="colorPrimary">#6C55C9</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E8E1FF</item>
        <item name="colorOnPrimaryContainer">#241A45</item>
        <item name="colorSecondary">#6C55C9</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#E8E1FF</item>
        <item name="colorOnSecondaryContainer">#241A45</item>
        <item name="colorTertiary">#8A76D8</item>
        <item name="colorOutline">#7C7690</item>
        <item name="colorOutlineVariant">#CCC6DC</item>
        <item name="colorSurface">#F7F6FC</item>
        <item name="colorSurfaceBright">#FFFFFF</item>
        <item name="colorSurfaceDim">#E4E1EE</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#F4F3FB</item>
        <item name="colorSurfaceContainer">#EFEDF8</item>
        <item name="colorSurfaceContainerHigh">#E9E7F5</item>
        <item name="colorSurfaceContainerHighest">#E3E0F0</item>
        <item name="android:colorBackground">#F2F3FA</item>
        <item name="colorOnBackground">#1B1B22</item>
        <item name="colorOnSurface">#1B1B22</item>
        <item name="colorOnSurfaceVariant">#54505F</item>
        <item name="colorSurfaceVariant">#E7E4F2</item>
        <item name="colorSurfaceInverse">#1B2336</item>
        <item name="colorOnSurfaceInverse">#F2F5FA</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Glass.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Glass.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Glass.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Glass.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Glass.Corner.ExtraLarge</item>
        <item name="preferenceTheme">@style/AppTheme.PreferenceThemeOverlay.Glass</item>
    </style>

</resources>
