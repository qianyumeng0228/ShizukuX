<?xml version="1.0" encoding="utf-8"?>
<resources
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedResources">

    <dimen name="card_spacing">12dp</dimen>
    <dimen name="list_item_spacing">16dp</dimen>

    <dimen name="margin_horizontal">16dp</dimen>
    <dimen name="margin_vertical">12dp</dimen>

    <dimen name="dialog_top_padding">16dp</dimen>

    <dimen name="default_app_icon_size">40dp</dimen>
    <dimen name="home_icon_padding">16dp</dimen>

    <dimen name="card_content_padding">16dp</dimen>

    <dimen name="m3e_spacing_small">8dp</dimen>
    <dimen name="m3e_spacing_medium">16dp</dimen>
    <dimen name="m3e_spacing_large">24dp</dimen>
    <dimen name="m3e_spacing_extra_large">32dp</dimen>

    <!-- Card geometry shared by every page, Compose and RecyclerView alike. The Compose screens
         draw their row cards with padding(horizontal = 12.dp) and pad the content 14dp further
         in, so the card edge sits 12dp from the screen edge. M3ECardItemDecoration used to paint
         its panes 16dp in, which left XML pages 4dp narrower than their Compose twins whenever
         the two were compared side by side. Content padding is the sum: 12dp edge + 14dp inset. -->
    <dimen name="glass_card_margin">12dp</dimen>
    <dimen name="glass_card_content_padding">26dp</dimen>

</resources>
