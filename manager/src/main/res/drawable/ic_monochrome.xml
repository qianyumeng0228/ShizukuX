<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="432"
    android:viewportHeight="432"
    android:tint="?attr/colorControlNormal">
    <!-- Only the plus badge is exposed to Themed Icons (Android 13+ Material You
         single-color re-tint). The cat and hexagon are intentionally omitted here:
         the OS renders this monochrome layer as the *entire* icon when Themed
         Icons is on, so this is as close as the platform allows to "just the
         plus is themed" — a full-color cat+hexagon can't coexist with a
         re-tinted glyph in the same themed-icon render. Position must stay in
         sync with the plus in drawable/ic_launcher_foreground.xml (scaled 4x:
         this viewport is 432 units for the same 108dp canvas). -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M 281.81,47.25 h 16.88 v 25.31 h 25.31 v 16.88 h -25.31 v 25.31 h -16.88 v -25.31 h -25.31 v -16.88 h 25.31 z" />
