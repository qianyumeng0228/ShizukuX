<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_search"
        android:icon="@drawable/ic_search_24"
        android:title="@string/settings_search"
        app:actionViewClass="androidx.appcompat.widget.SearchView"
        app:showAsAction="ifRoom" />

    <!-- Folder icon now means what it looks like: choosing the backup directory.
         "Back up all" used to wear this icon, so a tap on the folder started a
         destructive batch that uninstalls/reinstalls every app (user report). -->
    <item
        android:id="@+id/action_choose_dir"
        android:icon="@drawable/ic_folder_24"
        android:title="@string/backup_choose_export_dir"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/action_backup_all"
        android:icon="@drawable/ic_backup_all_24"
        android:title="@string/backup_all_title"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/action_show_system"
        android:checkable="true"
        android:title="@string/backup_show_system_apps"
        app:showAsAction="never" />

</menu>
