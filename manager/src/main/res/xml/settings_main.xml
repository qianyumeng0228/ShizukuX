<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:title="@string/settings_main_category_core_services"
        app:collapsible="false">

        <Preference
            android:key="nav_behavior"
            android:title="@string/settings_main_nav_startup_behavior_title"
            android:summary="@string/settings_main_nav_startup_behavior_summary"
            android:icon="@drawable/ic_settings_suggest_24"
            android:fragment="af.shizuku.manager.settings.BehaviorSettingsFragment" />

        <af.shizuku.manager.settings.ExtraNavPreference
            android:key="nav_root_integration"
            android:title="@string/settings_main_nav_root_compat_title"
            android:summary="@string/settings_main_nav_root_compat_summary"
            android:icon="@drawable/ic_shield_24"
            android:fragment="af.shizuku.manager.settings.RootIntegrationSettingsFragment" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:title="@string/settings_category_advanced_features"
        app:collapsible="false">

        <af.shizuku.manager.settings.ExtraNavPreference
            android:key="nav_shizuku_plus"
            android:title="@string/settings_main_nav_feature_hub_title"
            android:summary="@string/settings_main_nav_feature_hub_summary"
            android:icon="@drawable/ic_bolt_24"
            android:fragment="af.shizuku.manager.settings.ShizukuExtraSettingsFragment" />

        <af.shizuku.manager.settings.ExtraFeaturePreference
            android:key="dhizuku_mode"
            android:title="@string/settings_dhizuku_mode"
            android:summary="@string/settings_dhizuku_mode_summary"
            android:icon="@drawable/ic_admin_panel_settings_24"
            app:infoTitle="@string/help_dhizuku_title"
            app:infoDetail="@string/help_dhizuku_detail"
            app:badgeType="plus" />

        <!-- Only shown when app is active Device Owner; tapping clears DO status -->
        <Preference
            android:key="clear_device_owner"
            android:title="@string/settings_clear_device_owner"
            android:summary="@string/settings_clear_device_owner_summary"
            android:icon="@drawable/ic_delete_24"
            android:visible="false" />

        <!-- Only shown when app is active Device Owner; tapping transfers DO to another app -->
        <Preference
            android:key="transfer_device_owner"
            android:title="@string/settings_transfer_device_owner"
            android:summary="@string/settings_transfer_device_owner_summary"
            android:icon="@drawable/ic_swap_horiz_24"
            android:visible="false" />

        <!-- Dhizuku app management: list & control which apps may use the Dhizuku API -->
        <Preference
            android:key="dhizuku_app_management"
            android:title="@string/dhizuku_app_management_title"
            android:summary="@string/dhizuku_app_management_summary"
            android:icon="@drawable/ic_admin_panel_settings_24" />

        <af.shizuku.manager.settings.CollapsiblePreferenceCategory
            android:key="category_dhizuku_admin"
            android:title="@string/settings_device_owner_tools_category_title"
            android:dependency="dhizuku_mode"
            android:defaultValue="false">

            <SwitchPreferenceCompat
                android:key="dhizuku_disable_screencap"
                android:title="@string/settings_screen_capture_lockdown_title"
                android:summary="@string/settings_screen_capture_lockdown_summary"
                android:icon="@drawable/ic_visibility_off_24"
                android:defaultValue="false" />

            <SwitchPreferenceCompat
                android:key="dhizuku_disallow_usb"
                android:title="@string/settings_usb_data_lockdown_title"
                android:summary="@string/settings_usb_data_lockdown_summary"
                android:icon="@drawable/ic_shield_24"
                android:defaultValue="false" />

            <af.shizuku.manager.settings.AppPickerPreference
                android:key="dhizuku_suspended_packages"
                android:title="@string/settings_suspended_applications_title"
                android:summary="@string/settings_suspended_applications_summary"
                android:icon="@drawable/ic_science_24" />

        </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:title="@string/settings_main_category_personalization"
        app:collapsible="false">

        <Preference
            android:key="nav_personalization"
            android:title="@string/settings_category_appearance"
            android:summary="@string/settings_main_nav_appearance_summary"
            android:icon="@drawable/ic_palette_24"
            android:fragment="af.shizuku.manager.settings.PersonalizationSettingsFragment" />

        <Preference
            android:key="nav_app_management"
            android:title="@string/settings_main_nav_app_interactions_title"
            android:summary="@string/settings_main_nav_app_interactions_summary"
            android:icon="@drawable/ic_devices_24"
            android:fragment="af.shizuku.manager.settings.AppManagementSettingsFragment" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:title="@string/settings_main_category_diagnostics_help"
        app:collapsible="false">

        <Preference
            android:key="nav_advanced"
            android:title="@string/settings_main_nav_advanced_diagnostics_title"
            android:summary="@string/settings_main_nav_advanced_diagnostics_summary"
            android:icon="@drawable/ic_terminal_24"
            android:fragment="af.shizuku.manager.settings.AdvancedSettingsFragment" />

        <Preference
            android:key="nav_about"
            android:title="@string/settings_about"
            android:summary="@string/settings_main_nav_about_summary"
            android:icon="@drawable/ic_info_24"
            android:fragment="af.shizuku.manager.settings.AboutSettingsFragment" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

</PreferenceScreen>
