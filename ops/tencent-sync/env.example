# Copy to /etc/shizukux-sync.env, chmod 640, owner root:ubuntu.
# Never commit real tokens to the repository.

GITEE_TOKEN=
CNB_TOKEN=
JIHULAB_TOKEN=
GITCODE_TOKEN=

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=shizukux-updates-1442128143
COS_REGION=ap-guangzhou

# Public R2 custom domain. Assets are downloaded with HTTP Range requests.
SHIZUKUX_CDN=https://cdn.shizukux.xyz

# How long the worker waits for GitCode's Pull Mirror to deliver a tag.
GITCODE_TAG_TIMEOUT=180

# Optional GitHub token for higher API rate limits.
# SHIZUKUX_GH_TOKEN=
